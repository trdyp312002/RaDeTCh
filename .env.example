# Google Sheets API credentials (copy to .env.local and fill in real values)
GOOGLE_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"

# Optional: override spreadsheet ID
# GOOGLE_SPREADSHEET_ID=

# Password gate for the whole site (login + all /api routes). Required.
# Set the same value on Railway. Without it the app stays locked.
APP_PASSWORD=change-me

# ── AI Secretary (WhyMan) ────────────────────────────────────────────────────
# Google AI (Gemini) API key — used by WhyMan life secretary AI
# Get your free key at: https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY=your-google-ai-api-key

# ── Discord Bot (Daily Diary) ──────────────────────────────────────────────────
# Discord Webhook URL — ส่งแจ้งเตือนออกไป (one-way)
# สร้าง: Discord → Edit Channel → Integrations → Webhooks → New Webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Discord Bot Token — รับคำสั่งจาก Discord (two-way)
# สร้าง: https://discord.com/developers/applications → New Application → Bot → Reset Token
DISCORD_BOT_TOKEN=your-bot-token-here

# Discord Application ID (Client ID)
# เจอได้ที่: Discord Developer Portal → Applications → <your app> → General Information → Application ID
DISCORD_CLIENT_ID=your-application-id-here

# Discord Guild (Server) ID — ตั้งค่านี้เพื่อให้คำสั่งขึ้นทันที (แนะนำสำหรับ dev)
# ถ้าไม่ตั้ง จะ register แบบ Global ซึ่งช้าสุด ~1 ชั่วโมง
# วิธีหา: Discord → เปิด Developer Mode → คลิกขวาที่ Server icon → Copy Server ID
DISCORD_GUILD_ID=your-server-id-here

# URL ของ Next.js app (bot ใช้เรียก API)
WHYMAN_APP_URL=http://localhost:3000

# ── Garmin Connect ────────────────────────────────────────────────────────────
# Used by /api/garmin to fetch sleep, steps, heart rate
# Your regular Garmin Connect login credentials
GARMIN_EMAIL=your-garmin-email@example.com
GARMIN_PASSWORD=your-garmin-password

# ── Turso Cloud Database (optional — uses local SQLite if not set) ────────────
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your-turso-token
